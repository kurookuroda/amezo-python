+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+#
+# jump.py - 外部サイトへの中継ページ (jump.php の Python 移植。/jump.cgi も、ここに向く)
+#
+#   投稿された URL へのリンクは、このページを経由する: /jump.cgi?u=<URL (base64url)>&s=<署名>
+#   署名が合うもの (= この掲示板に実際に投稿された URL) だけを表示する。署名がなければ、
+#   このページは「どんな URL へも飛ばせる踏み台」になってしまい、フィッシングに悪用される。
+#   自動では転送しない。飛び先を文字で全部見せて、「進む」を押したときだけ外へ出る。
+#
+#   署名の照合・URL の検査・base64url の復号は amezo.py の
+#   jump_verify / url_is_valid / b64url_decode を使う (jump.php が lib.php を使うのと同じ分担)。
+
+import sys
+import os
+import re
+import secrets
