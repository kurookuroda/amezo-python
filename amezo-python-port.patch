+# -*- coding: utf-8 -*-
+# amezo.py の関数レベルのテスト (PHP 版 tests/unit.php の config / 中継リンク / 鍵 相当)。
+# 実行: python3 tests/unit_test.py   (OK/NG を数えて、NG があれば exit 1)
+import os
+import re
+import sys
+import tempfile
+
+import shutil  # noqa: E402
+
+_work = tempfile.mkdtemp(prefix='amezo_unit_')
+_src = os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'amezo.py')
+shutil.copy(_src, os.path.join(_work, 'amezo.py'))   # amezo.py は自分のフォルダに chdir するので、コピーして読み込む
+sys.path.insert(0, _work)
+os.chdir(_work)
+import amezo  # noqa: E402
+
+ng = 0
+ok = 0
+
+
+def chk(name, got, want):
+    global ng, ok
+    if got == want:
+        ok += 1
+        print(f'OK {name}')
+    else:
+        ng += 1
+        print(f'NG {name}: got={got!r} want={want!r}')
+
+
+# ---- config.ini ----
+def loadcfg(ini):
+    fd, path = tempfile.mkstemp()
+    os.write(fd, ini.encode())
+    os.close(fd)
+    try:
+        return amezo.config_load(path)
+    finally:
+        os.unlink(path)
+
+
+v, e = loadcfg('; c\nPOST_INTERVAL = 7 ; 行末\nMAX_THREADS = "50"\nJUMP_ENABLED = off\n'
+               'AMEZO = ＠テスト\nTRUSTED_PROXIES[] = 127.0.0.1\nTRUSTED_PROXIES[] = ::1\n'
+               'URLBASE = http://example.com/\n')
+chk('config: 正しい値は型を直して通る', v,
+    {'POST_INTERVAL': 7, 'MAX_THREADS': 50, 'JUMP_ENABLED': False, 'AMEZO': '＠テスト',
+     'TRUSTED_PROXIES': ['127.0.0.1', '::1'], 'URLBASE': 'http://example.com/'})
+chk('config: 正しい値ならエラーなし', e, [])
+
+BAD = {
+    'ADMIN = "${HOME}"': 'ADMIN',
+    'SUBJ_MAX = E_ALL': 'SUBJ_MAX',
+    'COMM_MAX = 400abc': 'COMM_MAX',
+    'NAME_MAX =': 'NAME_MAX',
+    'POST_INTERVAL = 99999': 'POST_INTERVAL',
+    'POST_INTERVAL = -1': 'POST_INTERVAL',
+    'POST_INTERVAL = 1.5': 'POST_INTERVAL',
+    'HASH_ITERATIONS = 10': 'HASH_ITERATIONS',
+    'AMEZO = <script>alert(1)</script>': 'AMEZO',
+    'AMEZO = a"b': 'AMEZO',
+    'AMEZO = a&b': 'AMEZO',
+    'ADMIN =': 'ADMIN',
+    'URLBASE = javascript:alert(1)': 'URLBASE',
+    'URLBASE = http://a.com/"><x': 'URLBASE',
+    'TRUSTED_PROXIES[] = not-an-ip': 'TRUSTED_PROXIES',
+    'JUMP_ENABLED = maybe': 'JUMP_ENABLED',
+    'UNKNOWN_KEY = 1': 'UNKNOWN_KEY',
+    'TRIP_CTX = evil': 'TRIP_CTX',
+    'TRIP_SECRET_FILE = /etc/passwd': 'TRIP_SECRET_FILE',
+}
+for line, key in BAD.items():
+    v, e = loadcfg(line + '\n')
+    chk(f'config: 無視される: {line}', (key in v, len(e)), (False, 1))
+
+v, _ = loadcfg('AMEZO = ' + 'あ' * 40 + '\n')
+chk('config: 40文字ちょうどは通る', len(v.get('AMEZO', '')), 40)
+v, _ = loadcfg('AMEZO = ' + 'あ' * 41 + '\n')
+chk('config: 41文字は通らない', 'AMEZO' in v, False)
+v, _ = loadcfg('TRUSTED_PROXIES =\n')
+chk('config: TRUSTED_PROXIES を空にすると、どのプロキシも信用しない', v, {'TRUSTED_PROXIES': []})
+v, e = loadcfg('POST_INTERVAL = 3\n[bad\n')
+chk('config: 書き方の誤り (構文エラー) は、全体を使わない', (v, len(e)), ({}, 1))
+v, e = loadcfg('AMEZO = "abc\nPOST_INTERVAL = 3\n')
+chk('config: 閉じていない引用符の行は無視され、ほかの行は使われる', (v, len(e)), ({'POST_INTERVAL': 3}, 1))
+v, e = loadcfg('POST_INTERVAL = 3\nPOST_INTERVAL = 99999\nMAX_THREADS = 10\n')
+chk('config: 同じキーが複数あっても、最後の値で検査される', (v, len(e)), ({'MAX_THREADS': 10}, 1))
+chk('config: ファイルが無ければ空', amezo.config_load('/nonexistent/config.ini'), ({}, []))
+defaults_ok = True
+for k, (t, d, mn, mx) in amezo.config_schema().items():
+    if t in ('ips', 'bool'):
+        continue
+    o, _ = amezo.config_check(t, str(d), mn, mx)
+    if not o:
+        defaults_ok = k
+chk('config: 表の既定値は、自分の検査を通る', defaults_ok, True)
+
+# ---- 中継リンク (jump) ----
+out = amezo.linkify_urls(amezo.html_escape('x https://a.com/?x=1&y=2'), True)
+m = re.search(r'href="\.\./jump\.cgi\?u=([^&]+)&amp;s=([^"]+)"', out)
+chk('中継リンク: href が jump.cgi', m is not None, True)
+u, s = m.group(1), m.group(2)
+chk('中継リンク: u を戻すと元の URL', amezo.b64url_decode(u).decode(), 'https://a.com/?x=1&y=2')
+chk('中継リンク: 署名が合う', amezo.jump_verify('https://a.com/?x=1&y=2', s), True)
+chk('中継リンク: 署名の改ざんは通らない', amezo.jump_verify('https://a.com/?x=1&y=2', 'A' * 22), False)
+chk('中継リンク: 表示する文字は元の URL', '>https://a.com/?x=1&amp;y=2</a>' in out, True)
+chk('中継リンク: target/rel が付く', 'target="_blank" rel="noopener noreferrer nofollow"' in out, True)
+chk('中継リンク: 同じ本文は同じ出力 (二重投稿の判定が効く)',
+    amezo.linkify_urls(amezo.html_escape('x https://a.com/b'), True),
+    amezo.linkify_urls(amezo.html_escape('x https://a.com/b'), True))
+chk('中継リンク: 直リンク指定 (False) は元の形',
+    'href="https://a.com/x"' in amezo.linkify_urls('https://a.com/x', False), True)
+evil = amezo.linkify_urls(amezo.html_escape('https://a.com/x," onmouseover="alert(1)'), True)
+chk('中継リンク: 属性を抜け出せない', re.search(r'<[^>]*onmouseover', evil) is None, True)
+chk('中継リンク: 直後の日本語は URL に含めない',
+    amezo.linkify_urls(amezo.html_escape('https://a.com/bです'), True).endswith('</a>です'), True)
+chk('中継リンク: 末尾の句読点は含めない',
+    amezo.linkify_urls(amezo.html_escape('(https://a.com/b).'), True).endswith('</a>).'), True)
+chk('url_is_valid: javascript は不可', amezo.url_is_valid('javascript:alert(1)'), False)
+chk('url_is_valid: 長すぎる URL は不可', amezo.url_is_valid('https://a.com/' + 'x' * 2000), False)
+chk('b64url: 不正な文字種は None', amezo.b64url_decode('a+b/c='), None)
+chk('b64url: 往復', amezo.b64url_decode(amezo.b64url_encode(b'\x00\xffabc')), b'\x00\xffabc')
+
+# ---- 認証キー ----
+os.makedirs('board1')
+r = amezo.key_issue('board1', ' テスト ', '123')
+chk('鍵: 発行できる', r is not None, True)
+kid, disp = r
+chk('鍵: 表示は4文字区切り24文字', re.fullmatch(r'[A-Z2-7]{4}(-[A-Z2-7]{4}){5}', disp) is not None, True)
+chk('鍵: 照合できる', amezo.key_verify('board1', '123', disp), True)
+chk('鍵: 小文字・区切りなしでも通る', amezo.key_verify('board1', '123', disp.replace('-', '').lower()), True)
+chk('鍵: 範囲外のスレッドは不可', amezo.key_verify('board1', '999', disp), False)
+chk('鍵: 間違ったキーは不可', amezo.key_verify('board1', '123', 'AAAA-AAAA-AAAA-AAAA-AAAA-AAAA'), False)
+r2 = amezo.key_issue('board1', '', '*')
+chk('鍵: 板全体のキーは他スレッドでも通る', amezo.key_verify('board1', '999', r2[1]), True)
+chk('鍵: ラベル空は (無題)', amezo.keys_load('board1')[1]['label'], '(無題)')
+chk('鍵: 失効できる', amezo.key_revoke('board1', kid), True)
+chk('鍵: 失効後は不可', amezo.key_verify('board1', '123', disp), False)
+chk('鍵: 再失効は失敗', amezo.key_revoke('board1', kid), False)
+with open('board1/123.html', 'w', encoding='utf-8') as f:
+    f.write('<html><body><dl><dt>1 x</dl>\n' + amezo.reply_form('123') + '</body></html>\n')
+chk('鍵: かける', amezo.thread_set_lock('board1', '123', True) and amezo.thread_is_locked('board1', '123'), True)
+chk('鍵: フォームに鍵欄が付く', 'name="key"' in open('board1/123.html', encoding='utf-8').read(), True)
+chk('鍵: 外す', amezo.thread_set_lock('board1', '123', False) and not amezo.thread_is_locked('board1', '123'), True)
+chk('鍵: フォームから鍵欄が消える', 'name="key"' not in open('board1/123.html', encoding='utf-8').read(), True)
+
+# ---- ページ送り ----
+os.makedirs('board2')
+for i in range(45):
+    open(f'board2/{260101000000 + i}.html', 'w').close()
+chk('page_clamp: 範囲内はそのまま', amezo.page_clamp('board2', 2), 2)
+chk('page_clamp: 範囲外は最後のページ', amezo.page_clamp('board2', 99), 3)
+chk('page_clamp: 1以下は1', amezo.page_clamp('board2', 0), 1)
+p = amezo.pager_html('board2', 1, 3)
+chk('pager: 10ページ以下は全部の番号', all(f'>{i}</a>' in p or f'>[{i}]<' in p or f'<b>[{i}]</b>' in p for i in (1, 2, 3)), True)
+chk('pager: 現在ページは [N]', '<b>[1]</b>' in p, True)
+chk('pager: 外側の class', 'class="row links pager"' in p, True)
+p = amezo.pager_html('board2', 10, 20)
+chk('pager: 多いときは間を … にする', '…' in p and '>5</a>' not in p, True)
+chk('pager: 1ページだけなら空', amezo.pager_html('board2', 1, 1), '')
+
+# ---- 転送 IP の厳密検証 ----
+os.environ['REMOTE_ADDR'] = '127.0.0.1'
+os.environ['HTTP_CF_CONNECTING_IP'] = '999.1.1.1'
+chk('client_ip: 壊れた転送 IP は信用しない', amezo.client_ip(), '127.0.0.1')
+os.environ['HTTP_CF_CONNECTING_IP'] = '203.0.113.9'
+chk('client_ip: 正しい転送 IP は使う', amezo.client_ip(), '203.0.113.9')
+
+print(f'== OK {ok} / NG {ng}')
+sys.exit(1 if ng else 0)
