+        links = (f'<div class="row links"><a href="{res_id}.html">レス全部を見る</a> '
+                 f'{sub_tag}<a href="#top">上へ</a> <a href="./">リロード</a></div>')
+
+        W.write('</font></td></tr></table>\n' + reply_form(res_id, links) + '<hr>\n')
+
+    W.write(pager + '<hr></body></html>\n')
