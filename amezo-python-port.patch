+# -*- coding: utf-8 -*-
+# config.ini が amezo.py の設定値に効くことのテスト (PHP 版 tests/config_test.py 相当)。
+# 一時フォルダに amezo.py をコピーし、config.ini を置いて読み込ませ、値を取り出す。
+# 実行: python3 tests/config_test.py
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+ng = 0
+ok = 0
+
+
+def chk(name, cond, extra=''):
+    global ng, ok
+    if cond:
+        ok += 1
+        print(f'OK {name}')
+    else:
+        ng += 1
+        print(f'NG {name} {extra}')
+
+
+def run(files):
+    d = tempfile.mkdtemp(prefix='amezo_cfg_')
+    shutil.copy(os.path.join(ROOT, 'amezo.py'), os.path.join(d, 'amezo.py'))
+    for name, content in files.items():
+        with open(os.path.join(d, name), 'w', encoding='utf-8') as f:
+            f.write(content)
+    code = ('import json, amezo; print(json.dumps([amezo.POST_INTERVAL, amezo.MAX_THREADS, '
+            'amezo.JUMP_ENABLED, amezo.AMEZO, amezo.ADMIN, amezo.TRUSTED_PROXIES, '
+            'amezo.GLOBAL_WINDOW, amezo.ARCHIVE_QUIET_SECONDS]))')
+    r = subprocess.run([sys.executable, '-c', code], cwd=d, capture_output=True, text=True)
+    shutil.rmtree(d, ignore_errors=True)
+    if r.returncode != 0:
+        return None, r.stderr
+    return json.loads(r.stdout.strip().splitlines()[-1]), r.stderr
+
+
+v, err = run({})
+chk('config.ini が無ければ既定値', v == [5, 200, True, '＠あめぞう', 'サポート', ['127.0.0.1', '::1'], 180, 600], str(v))
+
+v, err = run({'config.ini': 'POST_INTERVAL = 0\nMAX_THREADS = 3\nJUMP_ENABLED = false\n'
+                            'AMEZO = ＠テスト\nADMIN = 管理人\nTRUSTED_PROXIES[] = 10.0.0.1\n'
+                            'GLOBAL_WINDOW = 0\nARCHIVE_QUIET_SECONDS = 60\n'})
+chk('config.ini の値が効く', v == [0, 3, False, '＠テスト', '管理人', ['10.0.0.1'], 0, 60], str(v))
+
+v, err = run({'config.ini': 'POST_INTERVAL = 99999\nMAX_THREADS = 3\n'})
+chk('範囲外の値は無視され既定値、理由が標準エラーに出る',
+    v is not None and v[0] == 5 and v[1] == 3 and 'POST_INTERVAL' in err, f'{v} / {err}')
+
+v, err = run({'config.ini': 'POST_INTERVAL = 3\n[bad\n'})
+chk('構文エラーなら config.ini 全体を使わない', v is not None and v[0] == 5 and '読み込めません' in err, f'{v} / {err}')
+
+print(f'== OK {ok} / NG {ng}')
+sys.exit(1 if ng else 0)
