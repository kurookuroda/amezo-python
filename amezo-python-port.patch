+# -*- coding: utf-8 -*-
+#
+# archive.py - 退避済みの過去ログ (oN.html) を gzip -6 で oN.html.gz にする (CLI 専用。投稿の外で動かす)
+#
+#   python3 archive.py 板名… | --all  [--quiet=秒] [--limit=件数] [--dry-run] [-v]
+#   python3 archive.py --restore 板名 oN        (gz から平文を作る。gz は残す)
+#   python3 archive.py --selftest [板名]        (nlink / flock / rename / 更新日時 / gzip が、この環境で働くかを確認)
+#
+# 段階1: 平文から oN.html.gz を作る (平文は残す)。
+# 段階2: gz の作成から十分たち、gz が平文と同期し、中身が一致するときだけ、平文を消す (消す直前に平文の flock を取って再確認)。
+# 投稿側 (amezo.py) は、flock を取った直後に nlink を確認する。この2つが組になって、投稿の静かな消失を防ぐ。
+# 安全の保証はこの構造が担う。--quiet (既定 ARCHIVE_QUIET_SECONDS) の待機は、無駄を減らす工夫にすぎない。
+#
+# archive.php の Python 移植。挙動・出力文言・終了コードは PHP 版に合わせる。
+
+import sys
+import os
+import re
+import time
+import fcntl
+import hashlib
+import shutil
+import struct
+import subprocess
+import select
+import resource
+
+try:
+    import gzip
+except ImportError:
+    gzip = None
+
+# スクリプトのあるディレクトリに固定 (amezo.py / lib.php と同じ。相対パス ./blist.txt などの基準)
+try:
+    os.chdir(os.path.dirname(os.path.abspath(__file__)))
+except Exception:
+    pass
+
+
+def _local_is_board(folder):
+    """amezo.is_board が使えないときの代替 (blist.txt の1列目と一致するか)"""
+    try:
+        with open('./blist.txt', 'r', encoding='utf-8') as f:
+            for line in f:
+                line = line.rstrip('\r\n')
+                if line and line.split(',')[0] == folder:
+                    return True
+    except FileNotFoundError:
+        pass
+    return False
+
+
+# amezo.py から設定と板判定を借りる。import できない・名前が無い場合は代替で動く
+ARCHIVE_QUIET_SECONDS = 600
+is_board = _local_is_board
+try:
+    import amezo
+    _q = getattr(amezo, 'ARCHIVE_QUIET_SECONDS', None)
+    if isinstance(_q, int) and 0 <= _q <= 604800:
+        ARCHIVE_QUIET_SECONDS = _q
+    if callable(getattr(amezo, 'is_board', None)):
+        is_board = amezo.is_board
+except Exception:
+    pass
+
+ARCH_LOCK_TRIES = 50            # 平文のロックを待つ回数 (0.1秒おき = 最大5秒)
+ARCH_TMP_MAX_AGE = 86400        # これより古い一時ファイル (.gz.tmp*) は掃除する
+CHUNK = 65536
+
+
+def arch_out(s):
+    sys.stdout.write(s + "\n")
+    sys.stdout.flush()
+
+
+def arch_err(s):
+    sys.stderr.write(s + "\n")
+
+
+def arch_mb(b):
+    return f"{b / 1048576:.2f}MB"
+
+
+class ArchStat:
+    __slots__ = ('size', 'mtime', 'ctime')
+
+    def __init__(self, st):
+        self.size = st.st_size
+        self.mtime = int(st.st_mtime)
+        self.ctime = int(st.st_ctime)
+
+
+def arch_stat(p):
+    """stat を新しく読む。読めなければ None"""
+    try:
+        return ArchStat(os.stat(p))
+    except OSError:
+        return None
+
+
+def arch_file_digest(p):
+    """[sha256, 長さ]。読めなければ None"""
+    try:
+        f = open(p, 'rb')
+    except OSError:
+        return None
+    h = hashlib.sha256()
+    n = 0
+    with f:
+        while True:
+            b = f.read(CHUNK)
+            if b == b'':
+                break
+            n += len(b)
+            h.update(b)
+    return [h.hexdigest(), n]
+
+
+def arch_gz_digest(gz):
+    """gz を最後まで展開して [sha256, 長さ] を返す。開けなければ None"""
+    if gzip is None:
+        return None
+    try:
+        g = gzip.open(gz, 'rb')
+    except OSError:
+        return None
+    h = hashlib.sha256()
+    n = 0
+    try:
+        with g:
+            while True:
+                b = g.read(CHUNK)
+                if b == b'':
+                    break
+                n += len(b)
+                h.update(b)
+    except Exception:
+        return None
+    return [h.hexdigest(), n]
+
+
+def arch_gz_isize(gz):
+    """gz 末尾4バイト (ISIZE = 元のサイズ。4GiB で折り返す)"""
+    try:
+        with open(gz, 'rb') as f:
+            f.seek(-4, os.SEEK_END)
+            b = f.read(4)
+    except OSError:
+        return None
+    return struct.unpack('<I', b)[0] if len(b) == 4 else None
+
+
+_PLAIN_RE = re.compile(r'o(\d+)\.html')
+_GZ_RE = re.compile(r'o(\d+)\.html\.gz')
+_TMP_RE = re.compile(r'o\d+\.html\.gz\.tmp\d*')
+
+
+def arch_scan(folder):
+    """板フォルダの中の、過去ログを数える。(平文, gz (どちらも 名前 => 番号), 一時ファイルのパス)"""
+    plain = {}
+    gz = {}
+    tmp = []
+    try:
+        files = os.listdir(f"./{folder}")
+    except OSError:
+        return {}, {}, []
+    for name in files:
+        if not name.startswith('o'):
+            continue
+        m = _PLAIN_RE.fullmatch(name)
+        if m:
+            plain[name] = int(m.group(1))
+            continue
+        m = _GZ_RE.fullmatch(name)
+        if m:
+            gz[name[:-3]] = int(m.group(1))
+            continue
+        if _TMP_RE.fullmatch(name):
+            tmp.append(f"./{folder}/{name}")
+    plain = dict(sorted(plain.items(), key=lambda kv: kv[1]))
+    gz = dict(sorted(gz.items(), key=lambda kv: kv[1]))
+    return plain, gz, tmp
+
+
+class Archiver:
+    def __init__(self, quiet, dry, verbose):
+        self.quiet = quiet
+        self.dry = dry
+        self.verbose = verbose
+        self.c = {'compressed': 0, 'plain_removed': 0, 'stale_gz_removed': 0,
+                  'quarantined': 0, 'ng': 0, 'in': 0, 'out': 0, 'skip': {}}
+
+    def say(self, path, msg):
+        arch_out(f"{path.lstrip('./'):<34} {msg}")
+
+    def skip(self, path, reason):
+        self.c['skip'][reason] = self.c['skip'].get(reason, 0) + 1
+        if self.verbose:
+            self.say(path, f"skip: {reason}")
+        return False
+
+    def ng(self, path, msg):
+        self.c['ng'] += 1
+        self.say(path, f"NG: {msg}")
+        return False
+
+    def stage1(self, plain):
+        """段階1: 平文から gz を作る。作った (dry-run では作る予定の) なら True"""
+        st = arch_stat(plain)
+        if st is None:
+            return self.skip(plain, 'ファイルが無い')
+        if int(time.time()) - st.mtime < self.quiet:
+            return self.skip(plain, '最後の書き込みから間もない')
+        try:
+            free = shutil.disk_usage(os.path.dirname(plain) or '.').free
+        except OSError:
+            free = None
+        if free is not None and free < st.size + 1048576:
+            return self.skip(plain, 'ディスクの空きが足りない')
+        if self.dry:
+            self.say(plain, f"[dry-run] 圧縮する ({arch_mb(st.size)})")
+            self.c['compressed'] += 1
+            return True
+        t0 = time.time()
+        gzpath = plain + '.gz'
+        tmp = gzpath + '.tmp' + str(os.getpid())
+        try:
+            fin = open(plain, 'rb')
+            fout = gzip.open(tmp, 'wb', compresslevel=6)
+        except Exception:
+            try:
+                fin.close()
+            except Exception:
+                pass
+            try:
+                os.unlink(tmp)
+            except OSError:
+                pass
+            return self.ng(plain, '開けない (権限・空き容量を確認)')
+        h = hashlib.sha256()
+        n = 0
+        with fin:
+            while True:                     # ストリーム: メモリは一定
+                b = fin.read(CHUNK)
+                if b == b'':
+                    break
+                n += len(b)
+                h.update(b)
+                fout.write(b)
+        try:
+            fout.close()
+            closed = True
+        except Exception:
+            closed = False
+        src = h.hexdigest()
+        d = arch_gz_digest(tmp) if closed else None    # 展開して、元と一致することを確かめる
+        if d is None or d[0] != src or d[1] != n:
+            try:
+                os.unlink(tmp)
+            except OSError:
+                pass
+            return self.ng(plain, '展開して確かめたら、元と一致しない (一時ファイルを消した)')
+        st2 = arch_stat(plain)                          # 圧縮している間に、元が書き換わっていないか
+        if st2 is None or st2.size != st.size or st2.mtime != st.mtime or n != st.size:
+            try:
+                os.unlink(tmp)
+            except OSError:
+                pass
+            return self.skip(plain, '圧縮している間に元が変わった')
+        try:
+            os.utime(tmp, (st.mtime, st.mtime))         # 更新日時を引き継ぐ (同期の印。kako の並びも保つ)
+        except OSError:
+            pass
+        try:
+            os.chmod(tmp, 0o644)
+        except OSError:
+            pass
+        try:
+            os.rename(tmp, gzpath)
+        except OSError:
+            try:
+                os.unlink(tmp)
+            except OSError:
+                pass
+            return self.ng(plain, 'rename できない')
+        gs = arch_stat(gzpath)
+        gsize = gs.size if gs is not None else 0
+        self.c['compressed'] += 1
+        self.c['in'] += st.size
+        self.c['out'] += gsize
+        self.say(plain, f"圧縮  {arch_mb(st.size)} → {arch_mb(gsize)} "
+                        f"({st.size / max(1, gsize):.1f}倍)  {(time.time() - t0) * 1000:.0f}ms")
+        return True
+
+    def stage2(self, plain):
+        """段階2: 平文と gz が両方あるとき、条件が全部合えば、平文を消す"""
+        gzpath = plain + '.gz'
+        sp = arch_stat(plain)
+        sg = arch_stat(gzpath)
+        if sp is None or sg is None:
+            return
+        if sg.mtime != sp.mtime:                        # 圧縮のあとに、平文が更新された → gz は古い
+            if self.dry:
+                self.say(plain, '[dry-run] 古い gz を削除する')
+                self.c['stale_gz_removed'] += 1
+                return
+            try:
+                os.unlink(gzpath)
+            except OSError:
+                pass
+            self.c['stale_gz_removed'] += 1
+            self.say(plain, '古い gz を削除 (平文が圧縮のあとに更新された。次回に再圧縮する)')
+            return
+        if int(time.time()) - sg.ctime < self.quiet:
+            self.skip(plain, 'gz の作成から間もない')
+            return
+        if sp.size >= 4294967296:
+            self.skip(plain, '4GiB 以上は確認できない')
+            return
+        isize = arch_gz_isize(gzpath)
+        dp = arch_file_digest(plain)
+        dg = arch_gz_digest(gzpath)
+        if isize != sp.size or dp is None or dg is None or dp[0] != dg[0] or dp[1] != dg[1]:
+            # どちらが壊れているかは判定できない。何も消さず、gz を脇へ退避する (平文が配信され続ける。gz が正しければ、証拠として残る)
+            if self.dry:
+                self.say(plain, '[dry-run] NG: gz の中身が平文と一致しない → gz を .bad に改名する')
+                self.c['ng'] += 1
+                return
+            try:
+                os.rename(gzpath, gzpath + '.bad')
+            except OSError:
+                pass
+            self.c['quarantined'] += 1
+            self.ng(plain, 'gz の中身が平文と一致しない。どちらも消さず、gz を oN.html.gz.bad に改名した (人が確認する)')
+            return
+        try:
+            fh = open(plain, 'rb')
+        except OSError:
+            self.skip(plain, 'ロックのために開けない')
+            return
+        got = False
+        for _ in range(ARCH_LOCK_TRIES):
+            try:
+                fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
+                got = True
+                break
+            except OSError:
+                time.sleep(0.1)
+        if not got:
+            fh.close()
+            self.skip(plain, 'ロックが取れない (投稿中?)')
+            return
+        fst = os.fstat(fh.fileno())                     # ロックを取ったあとで、確認した内容のままか
+        same = fst.st_nlink > 0 and fst.st_size == sp.size and int(fst.st_mtime) == sp.mtime
+        if not same:
+            fcntl.flock(fh, fcntl.LOCK_UN)
+            fh.close()
+            self.skip(plain, 'ロックを待つあいだに変わった (次回に判断する)')
+            return
+        if self.dry:
+            fcntl.flock(fh, fcntl.LOCK_UN)
+            fh.close()
+            self.say(plain, '[dry-run] 平文を削除する')
+            self.c['plain_removed'] += 1
+            return
+        try:
+            os.unlink(plain)                            # ロックを持ったまま消す。待っている投稿は、nlink = 0 で弾かれる
+            ok = True
+        except OSError:
+            ok = False
+        fcntl.flock(fh, fcntl.LOCK_UN)
+        fh.close()
+        if not ok:
+            self.ng(plain, '平文を消せない')
+            return
+        self.c['plain_removed'] += 1
+        self.say(plain, '平文を削除 (gz に置き換え)')
+
+
+_CHILD_LOCK_CODE = (
+    "import sys, fcntl, time\n"
+    "f = open(sys.argv[1], 'r+b')\n"
+    "fcntl.flock(f, fcntl.LOCK_EX)\n"
+    "print('L', flush=True)\n"
+    "time.sleep(5)\n"
+)
+
+
+def arch_selftest(dirpath, full=True):
+    """環境の確認。full = False (毎回の簡易版) は、ctime の確認で待たない。[(ラベル, OKか, 詳細)] を返す"""
+    r = []
+
+    def add(label, ok, detail=''):
+        r.append([label, bool(ok), detail])
+
+    add('gzip モジュールが使える', gzip is not None)
+    base = dirpath.rstrip('/') + '/.archive-selftest-' + str(os.getpid())
+    a = base + '.a'
+    b = base + '.b'
+    try:
+        try:
+            with open(a, 'w', encoding='utf-8') as f:
+                f.write("selftest\n")
+        except OSError:
+            add('フォルダに書き込める', False, dirpath)
+            return r
+        add('フォルダに書き込める', True)
+        h = open(a, 'r+b')
+        s = os.fstat(h.fileno())
+        add('通常のファイルの nlink は 1', s.st_nlink == 1, f'nlink={s.st_nlink}')
+        os.unlink(a)
+        s = os.fstat(h.fileno())
+        add('開いたまま unlink すると nlink が 0 になる', s.st_nlink == 0, f'nlink={s.st_nlink}')
+        h.close()
+        with open(a, 'w', encoding='utf-8') as f:
+            f.write("selftest\n")
+        h = open(a, 'r+b')
+        os.rename(a, b)
+        s = os.fstat(h.fileno())
+        add('開いたまま rename しても nlink は 1 のまま', s.st_nlink == 1, f'nlink={s.st_nlink}')
+        h.close()
+        os.utime(b, (1700000000, 1700000000))
+        s = arch_stat(b)
+        add('os.utime で更新日時 (mtime) を指定できる', s is not None and s.mtime == 1700000000)
+        c0 = s.ctime if s is not None else 0
+        if full:
+            time.sleep(1)
+        os.rename(b, a)
+        s = arch_stat(a)
+        add('rename で ctime が更新され、mtime は保たれる',
+            s is not None and (s.ctime > c0 if full else s.ctime >= c0) and s.mtime == 1700000000,
+            f'ctime {c0} → {s.ctime if s is not None else "?"}')
+        locked = False
+        try:
+            h = open(a, 'r+b')
+            try:
+                proc = subprocess.Popen([sys.executable, '-c', _CHILD_LOCK_CODE, a],
+                                        stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+            except OSError:
+                proc = None
+            if proc is not None:
+                line = ''
+                ready, _, _ = select.select([proc.stdout], [], [], 5)
+                if ready:
+                    line = proc.stdout.readline().decode('utf-8', 'replace')
+                if line.strip() == 'L':
+                    try:
+                        fcntl.flock(h, fcntl.LOCK_EX | fcntl.LOCK_NB)
+                        locked = False
+                    except OSError:
+                        locked = True     # 別プロセスが持っている間は、取れない
+                proc.terminate()
+                proc.wait()
+            h.close()
+        except OSError:
+            locked = False
+        add('別プロセスが持っている flock は、こちらからは取れない', locked)
+        try:
+            shutil.disk_usage(dirpath)
+            add('shutil.disk_usage が使える', True)
+        except OSError:
+            add('shutil.disk_usage が使える', False)
+    finally:
+        for p in (a, b):
+            try:
+                os.unlink(p)
+            except OSError:
+                pass
+    return r
+
+
+def arch_all_boards():
+    """板名の一覧 (blist.txt の1列目)"""
+    r = []
+    try:
+        with open('./blist.txt', 'r', encoding='utf-8') as f:
+            lines = f.read().splitlines()
+    except OSError:
+        lines = []
+    for line in lines:
+        name = line.split(',')[0]
+        if name != '':
+            r.append(name)
+    return r
+
+
+def arch_valid_board(b):
+    return b != '' and '/' not in b and '..' not in b and is_board(b) and os.path.isdir(f"./{b}")
+
+
+def arch_usage():
+    arch_err("使い方:\n"
+             "  python3 archive.py 板名… | --all [--quiet=秒] [--limit=件数] [--dry-run] [-v]\n"
+             "  python3 archive.py --restore 板名 oN\n"
+             "  python3 archive.py --selftest [板名]")
+    raise SystemExit(2)
+
+
+def arch_restore(folder, oname):
+    """gz から平文を作る (gz は残す)。終了コードを返す"""
+    m = re.fullmatch(r'o?(\d+)(?:\.html)?', oname or '')
+    if not arch_valid_board(folder) or m is None:
+        arch_usage()
+    plain = f"./{folder}/o{m.group(1)}.html"
+    gzpath = plain + '.gz'
+    try:
+        lk = open(f"./{folder}/archive.lock", 'a+')
+        fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
+    except OSError:
+        arch_err(f"板 {folder}: 別の archive.py が実行中です")
+        return 2
+    if not os.path.isfile(gzpath):
+        arch_err(f"{gzpath} が無い")
+        return 2
+    if os.path.exists(plain):
+        arch_err(f"{plain} がすでにある (上書きはしない)")
+        return 2
+    sg = arch_stat(gzpath)
+    tmp = plain + '.restore.tmp' + str(os.getpid())
+    try:
+        g = gzip.open(gzpath, 'rb')
+        o = open(tmp, 'wb')
+    except Exception:
+        arch_err('開けない')
+        try:
+            os.unlink(tmp)
+        except OSError:
+            pass
+        return 2
+    n = 0
+    try:
+        with g, o:
+            while True:
+                b = g.read(CHUNK)
+                if b == b'':
+                    break
+                n += len(b)
+                o.write(b)
+    except Exception:
+        pass                                        # 壊れた gz は、長さの照合で弾く
+    if n != arch_gz_isize(gzpath):
+        try:
+            os.unlink(tmp)
+        except OSError:
+            pass
+        arch_err('展開した長さが、gz の記録と一致しない (gz が壊れている?)')
+        return 1
+    try:
+        os.utime(tmp, (sg.mtime, sg.mtime))
+    except OSError:
+        pass
+    try:
+        os.chmod(tmp, 0o644)
+    except OSError:
+        pass
+    try:
+        os.rename(tmp, plain)
+    except OSError:
+        try:
+            os.unlink(tmp)
+        except OSError:
+            pass
+        arch_err('rename できない')
+        return 1
+    arch_out(f"{plain} を作った ({arch_mb(n)})。gz は残してある。")
+    arch_out('  編集すると更新日時が変わり、配信は平文に切り替わる (古い gz は次回の実行で消え、その次に再圧縮される)。')
+    arch_out('  編集しなければ、次回以降の実行で、この平文はまた消える。')
+    return 0
+
+
+_QUIET_RE = re.compile(r'--quiet=(\d{1,7})')
+_LIMIT_RE = re.compile(r'--limit=(\d{1,9})')
+
+
+def main(argv):
+    opt = {'quiet': ARCHIVE_QUIET_SECONDS, 'limit': 0, 'dry': False, 'v': False,
+           'all': False, 'restore': False, 'selftest': False}
+    boards = []
+    for a in argv:
+        if a == '--all':
+            opt['all'] = True
+        elif a == '--dry-run':
+            opt['dry'] = True
+        elif a == '-v':
+            opt['v'] = True
+        elif a == '--restore':
+            opt['restore'] = True
+        elif a == '--selftest':
+            opt['selftest'] = True
+        elif (m := _QUIET_RE.fullmatch(a)) and int(m.group(1)) <= 604800:
+            opt['quiet'] = int(m.group(1))
+        elif (m := _LIMIT_RE.fullmatch(a)) and int(m.group(1)) >= 1:
+            opt['limit'] = int(m.group(1))
+        elif a != '' and not a.startswith('-'):
+            boards.append(a)
+        else:
+            arch_usage()
+    if opt['restore']:
+        if len(boards) != 2:
+            arch_usage()
+        return arch_restore(boards[0], boards[1])
+    if opt['all']:
+        boards = arch_all_boards()
+    if opt['selftest']:
+        allb = arch_all_boards()
+        b = boards[0] if boards else (allb[0] if allb else '')
+        if not arch_valid_board(b):
+            arch_usage()
+        bad = 0
+        arch_out(f"自己チェック (フォルダ: ./{b})")
+        for label, ok, detail in arch_selftest(f"./{b}"):
+            arch_out(('OK   ' if ok else 'NG   ') + label + (f"  ({detail})" if detail != '' else ''))
+            if not ok:
+                bad += 1
+        arch_out('すべて OK。この環境で archive.py を使えます。' if bad == 0
+                 else f"NG が {bad} 件。この環境では archive.py を動かさないでください。")
+        return 0 if bad == 0 else 2
+    if not boards:
+        arch_usage()
+    for b in boards:
+        if not arch_valid_board(b):
+            arch_err(f"板 {b}: 見つからない (blist.txt とフォルダを確認)")
+            return 2
+    if gzip is None:
+        arch_err('gzip モジュールが使えません (Python の gzip が必要)')
+        return 2
+    if not opt['dry']:                              # 毎回、簡易の自己チェック (dry-run は何も書かないので省略)
+        bad = [r for r in arch_selftest(f"./{boards[0]}", full=False) if not r[1]]
+        if bad:
+            for label, _, _ in bad:
+                arch_err(f"自己チェック NG: {label}")
+            arch_err('この環境では動かしません。`python3 archive.py --selftest 板名` で詳細を確認してください。')
+            return 2
+
+    # ---- 実行 ----
+    run = Archiver(opt['quiet'], opt['dry'], opt['v'])
+    remaining = opt['limit']
+    for folder in boards:
+        lk = None
+        if not opt['dry']:
+            try:
+                lk = open(f"./{folder}/archive.lock", 'a+')
+                fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
+            except OSError:
+                if lk is not None:
+                    lk.close()
+                arch_out(f"板 {folder}: 別の archive.py が実行中のため、スキップ")
+                continue
+        plain, gz, tmps = arch_scan(folder)
+        if not opt['dry']:
+            for t in tmps:                          # 古い一時ファイル (途中で止まった圧縮の残り) の掃除
+                s = arch_stat(t)
+                if s is not None and int(time.time()) - s.mtime > ARCH_TMP_MAX_AGE:
+                    try:
+                        os.unlink(t)
+                    except OSError:
+                        pass
+                    arch_out(t.lstrip('./') + '  古い一時ファイルを削除')
+        before = dict(run.c)
+        for name in plain:
+            if name in gz:
+                run.stage2(f"./{folder}/{name}")    # 段階2 (先に。今回作る gz は、次回以降)
+        for name in plain:
+            if name in gz:
+                continue
+            if opt['limit'] > 0 and remaining <= 0:
+                run.skip(f"./{folder}/{name}", '--limit に達した')
+                continue
+            if run.stage1(f"./{folder}/{name}") and opt['limit'] > 0:
+                remaining -= 1
+        def d(k, _before=before):
+            return int(run.c[k]) - int(_before[k])
+        arch_out(f"板 {folder}: 圧縮 {d('compressed')} ({arch_mb(d('in'))} → {arch_mb(d('out'))})、"
+                 f"平文削除 {d('plain_removed')}、古い gz 削除 {d('stale_gz_removed')}、"
+                 f"gz を退避 {d('quarantined')}、NG {d('ng')}")
+        if lk is not None:
+            fcntl.flock(lk, fcntl.LOCK_UN)
+            lk.close()
+    if run.c['skip']:
+        parts = [f"{k} {v}" for k, v in run.c['skip'].items()]
+        arch_out('スキップ: ' + ', '.join(parts))
+    if opt['v']:
+        peak = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss * 1024
+        arch_out(f"メモリのピーク {peak / 1048576:.1f}MB")
+    return 1 if run.c['ng'] > 0 else 0
+
+
+if __name__ == '__main__':
+    sys.exit(main(sys.argv[1:]))
