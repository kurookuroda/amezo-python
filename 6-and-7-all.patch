+            with open(f"./{folder}/{f_name}", 'r', encoding='utf-8') as rf:
+                first_line = rf.readline()
+                m_ttl = re.search(r'<b>([^<]*)</b>', first_line)
+                if m_ttl:
+                    ttl = m_ttl.group(1)
