+def ip_unit(ip):
+    """IPv6 は上位64bitでまとめる (下位は端末が勝手に変えるので)。IPv4 はそのまま。"""
+    if ':' in ip:
+        try:
+            packed = socket.inet_pton(socket.AF_INET6, ip)
+        except (OSError, ValueError):
+            return ip
+        if len(packed) == 16:
+            return packed[:8].hex()
+    return ip
+
+
+def id_key():
+    key = load_secret(ID_SECRET_FILE)
+    if not key:
