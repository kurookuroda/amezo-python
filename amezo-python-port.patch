+def _parse_ini_raw(text):
+    """INI の生の値を読む (展開はしない)。書き方の誤りがあれば None。
+    戻り値: {キー: 文字列 or [文字列]}。同じキーが複数あれば最後の値 (KEY[] は積む)。"""
+    raw = {}
+    for line in text.splitlines():
+        s = line.strip()
+        if s == '' or s.startswith(';') or s.startswith('#'):
+            continue
+        if s.startswith('[') or '=' not in s:
+            return None
+        k, _, v = s.partition('=')
+        k = k.strip()
+        v = v.strip()
+        if k == '':
+            return None
+        is_list = k.endswith('[]')
+        if is_list:
+            k = k[:-2].strip()
+        if v.startswith('"'):
+            end = v.find('"', 1)
+            if end > 0:
+                v = v[1:end]
+        else:
+            v = re.split(r'[ \t];', v, maxsplit=1)[0].strip()
+        if is_list:
+            prev = raw.get(k)
+            if isinstance(prev, list):
+                prev.append(v)
+            elif prev is None:
+                raw[k] = [v]
+            else:
+                raw[k] = [prev, v]
+        else:
+            raw[k] = v
