+ok('ID は3日たつと捨てる', r.hiddenAtLoad === 0 && r.errs.length === 0);
+r = run(JSON.stringify({'trip:tripX': now - 400 * DAY}));
+ok('トリップは期限なし (400日前でも残る)', r.hiddenAtLoad === 2);
+r = run(JSON.stringify({'id:idA1': now - 4 * DAY, 'trip:tripX': now - 400 * DAY}));
